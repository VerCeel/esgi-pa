# Copier en .env.prod sur le Droplet, puis remplir. Ne JAMAIS versionner .env.prod.
# docker compose lit ce fichier via : docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

DOMAIN=budgie.verceel.me

# Générer UNE fois avec : echo "base64:$(openssl rand -base64 32)"
# et ne plus jamais changer (sinon les données chiffrées deviennent illisibles).
APP_KEY=

STRIPE_SECRET=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=


